def lancement():
    global lien_live_direct
    """Récupère les dernières vidéos via l'API RSS de YouTube."""
    global miniatures, ctk_images, opposition_direct,opposition_replay
    miniatures.clear()
    ctk_images.clear()

    rss_url = f"https://www.youtube.com/feeds/videos.xml?channel_id={CHANNEL_ID}"
    feed = feedparser.parse(rss_url)

    if not feed.entries:
        print("❌ Aucun contenu trouvé dans le flux RSS.")
        return

    lives = []

    print("🎥 Dernières vidéos publiées :")
    for entry in feed.entries[:12]:  # Limite aux 10 dernières vidéos
        video_id2 = entry['yt_videoid']
        title2 = entry.title
        link2 = entry.link

        print(f"▶ {title2} - {link2}")
        liste_liens_replay.append(link2)
        # Vérification avec regex
        match = re.search(pattern, title2)
        if match:
            team1a, team2a = match.groups()
            opposition_replay=f"🏆 Match détecté: {team1a} VS {team2a}"
            opposition_replay_liste.append(opposition_replay)
            print(opposition_replay_liste)
            print(opposition_replay)
        else:
            print("⚠️ Aucun match détecté dans le titre.")

        # 📌 Vérification : est-ce un live ?
        if "LIVE" in title2.upper() or "STREAM" in title2.upper():
            lives.append((title2, link2, video_id2))

        # Ajout de la miniature
        get_thumbnail(video_id2)

    # 🔴 Affichage des lives trouvés
    if lives:
        print("\n🔴 Lives en cours :")
        for i, (title, link, video_id) in enumerate(lives, start=1):
            print(f"{i}. {title} - {link}")

            match = re.search(pattern, title)
            if match:
                team1, team2 = match.groups()
                opposition_direct=f"🏆 Match trouvé: {team1} vs. {team2}"
                print(opposition_direct)
                lien_live_direct=link
                get_thumbnail_live(video_id)
            else:
                print("⚠️ Aucun match détecté.")
    else:
        print("\n🚫 Aucun live actuellement.")


