# YouTube API
import feedparser
import requests
from PIL import Image, ImageEnhance
from io import BytesIO
import re

lien_live_direct = ''
miniatures_lives=[]
from customtkinter import *
opposition_replay=""
opposition_direct=""
# 🔹 Modèle regex pour détecter les matchs dans les titres
pattern = r"([A-Za-z0-9.]+)\s+vs\.\s+([A-Za-z0-9.]+)"
opposition_replay_liste=[]
liste_liens_direct=[]
liste_liens_replay=[]
# ID de la chaîne YouTube (fixe, ne change pas)
CHANNEL_ID = "UCp6n8d8Y8r3MwKNw_MMaouQ"
lives=[]
# 🎯 Stockage des miniatures et des images pour éviter leur suppression
miniatures = []
ctk_images = []  # ✅ Liste pour stocker les objets CTkImage

def get_thumbnail(video_id):
    """Télécharge et stocke la miniature d'une vidéo YouTube."""
    url = f"https://img.youtube.com/vi/{video_id}/maxresdefault.jpg"
    response = requests.get(url)

    if response.status_code == 200:
        miniature = Image.open(BytesIO(response.content)).convert("RGBA")
        miniatures.append(miniature)  # ✅ Copie indépendante pour éviter les références partagées
        print(f"✅ Miniature ajoutée pour {video_id}")


    else:
        print(f"❌ Impossible de récupérer la miniature pour {video_id}")
def get_thumbnail_live(video_id):
    """Télécharge et stocke la miniature d'une vidéo YouTube."""
    url = f"https://img.youtube.com/vi/{video_id}/maxresdefault.jpg"
    response = requests.get(url)

